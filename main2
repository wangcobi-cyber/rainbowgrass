function print_plot(i, j) {

    const state = grass_grid[i][j];
 
    if (state <= 2) {

        const purple = [0x24, 0x1a, 0x24];

        const red = [0x24, 0x1a, 0x1a];
 
        // Smoothly move from purple to red and back over a 5-second cycle.

        const cycle = (performance.now() % 5000) / 5000;

        const blend = (1 - Math.cos(cycle * 2 * Math.PI)) / 2;
 
        const r = Math.round(purple[0] + (red[0] - purple[0]) * blend);

        const g = Math.round(purple[1] + (red[1] - purple[1]) * blend);

        const b = Math.round(purple[2] + (red[2] - purple[2]) * blend);
 
        ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;

    } else {

        ctx.fillStyle = color_matching[state];

    }
 
    ctx.fillRect(

        i * plot_x + white_space,

        j * plot_y + white_space,

        plot_x - white_space,

        plot_y - white_space

    );

}

requestAnimationFrame(gameLoop);
 
 
