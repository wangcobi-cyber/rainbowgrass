}
 
function switch_grass(){

    for (let i = 0; i < size_x; i++) {

        for (let j = 0; j < size_y; j++) {

            grass_grid[i][j]= grass_grid_temp[i][j]

        }

    }

}
 
function update_plot(i,j){
 
    let r = Math.random();
 
    switch (grass_grid[i][j]) {

    case 0: //dirt

        let sprout_threshold = 1 //0.99999

        for (const [dx, dy] of dirs) {

            const ni = i + dx;

            const nj = j + dy;

            if (grass_grid[ni][nj]==2)

                sprout_threshold-=0.007

        }

        if (r>sprout_threshold)

            grass_grid_temp[i][j] =1

        else

            grass_grid_temp[i][j] = grass_grid[i][j]; 

        break;
 
    case 1:

        let grow_threshold = 0.998

        for (const [dx, dy] of dirs) {

            const ni = i + dx;

            const nj = j + dy;

            if (grass_grid[ni][nj]==2 && grass_grid[ni][nj]==3)

                grow_threshold+=0.0002

        }

        if (r>grow_threshold)

            grass_grid_temp[i][j] =2

        else

            grass_grid_temp[i][j] = grass_grid[i][j]; 

        break;
 
    case 2: {

        let burn_threshold = 0.999999;

        const neighboring_fire_colors = [];
 
        for (const [dx, dy] of dirs) {

            const ni = i + dx;

            const nj = j + dy;

            const neighbor = grass_grid[ni][nj];
 
            if (neighbor >= 3 && neighbor <= 12) {

                burn_threshold -= 0.1;

                neighboring_fire_colors.push(neighbor);

            }

        }
 
        if (neighboring_fire_colors.length > 0 && r > burn_threshold) {

            const source = neighboring_fire_colors[

                Math.floor(Math.random() * neighboring_fire_colors.length)

            ];
 
            // Usually match the neighboring fire; rarely use an adjacent color.

            if (Math.random() < 0.995) {

                grass_grid_temp[i][j] = source;

            } else {

                const adjacentColors = [

                    source === 3 ? 12 : source - 1,

                    source === 12 ? 3 : source + 1

                ];
 
                grass_grid_temp[i][j] =

                    adjacentColors[Math.floor(Math.random() * adjacentColors.length)];

            }

        } else if (neighboring_fire_colors.length === 0 && r > 1) { // 0.9999993) {

            // Randomly start a fire when no fire is adjacent.

            grass_grid_temp[i][j] = 3 + Math.floor(Math.random() * 10);

        } else {

            grass_grid_temp[i][j] = grass_grid[i][j];

        }
 
        break;

    }
 
 
    // case 3:

    //     let out_threshold = 0.99

    //     for (const [dx, dy] of dirs) {

    //         const ni = i + dx;

    //         const nj = j + dy;

    //         if (grass_grid[ni][nj]==3 &&  grass_grid[ni][nj]==0)

    //             out_threshold-=0.1

    //     }

    //     if (r>out_threshold)

    //         grass_grid_temp[i][j] =0

    //     else

    //         grass_grid_temp[i][j] = grass_grid[i][j]; 

    //     break;
 
    default:

        let out_threshold = 0.99

        for (const [dx, dy] of dirs) {

            const ni = i + dx;

            const nj = j + dy;

            if (grass_grid[ni][nj]==3 &&  grass_grid[ni][nj]==0)

                out_threshold-=0.1

        }

        if (r>out_threshold)

            grass_grid_temp[i][j] =0

        else

            grass_grid_temp[i][j] = grass_grid[i][j]; 

        break;

    }
 
    

    // if (r >0.99)

    //     grass_grid_temp[i][j] = (grass_grid[i][j]+1)%4   

    // else   

    //     grass_grid_temp[i][j] = grass_grid[i][j]; // keep current state

}
 
 
 
